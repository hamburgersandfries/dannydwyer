---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import VideoCard from '../components/VideoCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { getEmbedUrl, getThumbnailUrl } from '../lib/video';

const videos = await getCollection('videos');
const reel =
  videos.find((v) => v.data.urlSlug === site.homeReelSlug) ??
  videos.find((v) => v.data.featured) ??
  videos[0];

const FEATURED_SLUGS = ['ryan-gosling-mens-health', 'zoe-kravitz-harpers-bazaar', 'bored-final-dwyer'];
const featured = FEATURED_SLUGS.map((slug) => videos.find((v) => v.data.urlSlug === slug)).filter(
  (v): v is NonNullable<typeof v> => Boolean(v)
);
const featuredThumbnails = await Promise.all(featured.map((v) => getThumbnailUrl(v.data)));

const jsonLd = reel
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: reel.data.title,
        description: reel.data.summary,
        thumbnailUrl: await getThumbnailUrl(reel.data),
        uploadDate: reel.data.uploadDate,
        duration: reel.data.durationISO,
        embedUrl: getEmbedUrl(reel.data),
      },
    ]
  : [];
---

<Layout
  title="Home"
  description={site.tagline}
  jsonLd={jsonLd}
>
  <SiteHeader />

  {/* TODO: swap /images/dwyski.png here for the animated GIF once the source video is in */}
  <div class="motion-banner" role="img" aria-label={`${site.name} — motion banner`}></div>

  <main class="main container">
    <div class="grid">
      <div class="col-12">
        {reel && <VideoPlayer platform={reel.data.platform} videoId={reel.data.videoId} title={reel.data.title} />}
      </div>

      <section class="intro col-12">
        <h1>{site.role}</h1>
        <p>{site.introCopy}</p>
        <a class="cta" href="/videos">View the work &nbsp;→</a>
      </section>

      {featured.length > 0 && (
        <section class="featured col-12" aria-label="Featured work">
          <h2>Featured Work</h2>
          <div class="grid featured-grid">
            {featured.map((v, i) => (
              <div class="col-4">
                <VideoCard
                  slug={v.data.urlSlug}
                  title={v.data.title}
                  summary={v.data.summary}
                  tags={v.data.tags}
                  thumbnailUrl={featuredThumbnails[i]}
                  uploadDate={v.data.uploadDate}
                />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  /* Full-bleed motion banner: locked 50px tall, 100% viewport-width
     regardless of the site's centered content column, tiling the source
     image horizontally and scrolling it in a seamless infinite loop.
     Swap the background-image for the animated GIF once it exists — the
     mechanics (height, tiling, scroll) don't need to change. */
  .motion-banner {
    width: 100%;
    height: 50px;
    overflow: hidden;
    background-color: #000;
    background-image: url('/images/dwyski.png');
    background-repeat: repeat-x;
    background-size: auto 50px;
    animation: motion-scroll 14s linear infinite;
  }

  @keyframes motion-scroll {
    from {
      background-position-x: 0;
    }
    to {
      /* One tile's rendered width at 50px tall (source is 2100x1200,
         so 50 * 2100/1200 = 87.5px) — shifting by exactly that loops
         seamlessly no matter how many tiles fit across the viewport. */
      background-position-x: -87.5px;
    }
  }

  .main {
    padding-bottom: 2rem;
  }

  .intro {
    margin: 3rem 0 1rem;
  }

  .intro h1 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 1rem;
  }

  .intro p {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .cta {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    padding-bottom: 0.15rem;
  }

  .featured {
    margin: 1.5rem 0 3rem;
  }

  .featured h2 {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tag-muted);
    margin-bottom: 1.25rem;
  }

  .featured-grid {
    row-gap: 2rem;
  }
</style>
