---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { getEmbedUrl, getThumbnailUrl } from '../lib/video';

const videos = await getCollection('videos');
const reel =
  videos.find((v) => v.data.urlSlug === site.homeReelSlug) ??
  videos.find((v) => v.data.featured) ??
  videos[0];

const jsonLd = reel
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: reel.data.title,
        description: reel.data.summary,
        thumbnailUrl: await getThumbnailUrl(reel.data),
        uploadDate: reel.data.uploadDate,
        duration: reel.data.durationISO,
        embedUrl: getEmbedUrl(reel.data),
      },
    ]
  : [];
---

<Layout
  title="Home"
  description={site.tagline}
  jsonLd={jsonLd}
>
  <SiteHeader hideLogo />

  <div class="hero">
    <img src="/images/DWYSKI_LOVE.png" alt={site.name} />
  </div>

  <main class="main container">
    <div class="grid">
      <div class="col-12">
        {reel && <VideoPlayer platform={reel.data.platform} videoId={reel.data.videoId} title={reel.data.title} />}
      </div>

      <section class="intro col-12">
        <h1>{site.role}</h1>
        <p>{site.introCopy}</p>
        <a class="cta" href="/videos">View the work &nbsp;→</a>
      </section>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .hero {
    width: 100%;
    background: var(--bg);
    padding: clamp(1.5rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 2rem);
    display: flex;
    justify-content: center;
  }

  .hero img {
    width: 100%;
    max-width: 900px;
    height: auto;
    display: block;
  }

  .main {
    padding-bottom: 2rem;
  }

  .intro {
    margin: 3rem 0 1rem;
  }

  .intro h1 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 1rem;
  }

  .intro p {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .cta {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    padding-bottom: 0.15rem;
  }
</style>
