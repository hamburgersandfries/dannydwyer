---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  thumbnailUrl: string;
  uploadDate: string;
}
const { slug, title, summary, tags, thumbnailUrl, uploadDate } = Astro.props;
const year = new Date(uploadDate).getFullYear();
const searchText = `${title} ${summary} ${tags.join(' ')}`.toLowerCase();
---

<a
  class="row"
  href={`/videos/${slug}`}
  data-tags={tags.join('|').toLowerCase()}
  data-search={searchText}
>
  <div class="thumb">
    <img src={thumbnailUrl} alt="" loading="lazy" width="320" height="180" />
  </div>
  <div class="meta">
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <div class="tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
      <span class="year">{year}</span>
    </div>
  </div>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
  }

  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
    transition: filter 0.2s ease;
  }

  .row:hover .thumb img {
    filter: grayscale(0);
  }

  .meta h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .row:hover h3 {
    color: var(--accent);
  }

  .summary {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
    max-width: 60ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--tag-muted);
  }

  .tag::after {
    content: '·';
    margin-left: 0.6rem;
    color: var(--hairline);
  }

  .year {
    color: var(--text-muted);
  }
</style>
