---
import { site } from '../data/site';
const year = new Date().getFullYear();
const socialLinks = Object.entries(site.socials).filter(([, url]) => url);

// A few platform names have a correct brand casing that plain CSS
// text-transform: capitalize can't produce.
const displayNames: Record<string, string> = {
  imdb: 'IMDb',
  linkedin: 'LinkedIn',
};
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="links">
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
      {socialLinks.map(([name, url]) => (
        <a class="social" href={url} target="_blank" rel="noopener noreferrer">{displayNames[name] ?? name}</a>
      ))}
    </div>
    <span>&copy; {year} {site.name}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    margin-top: 4rem;
  }

  .footer-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.5rem;
    column-gap: 1.5rem;
  }

  .links .social {
    text-transform: capitalize;
  }

  .links a:hover {
    color: var(--accent);
  }
</style>
